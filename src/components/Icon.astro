  tree: '<path d="M4 6h4M4 12h4M4 18h4M10 6h10M10 12h7M10 18h12"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  text: '<path d="M4 7V5h16v2M9 19h6M12 5v14"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  swap: '<path d="M4 8h13l-3-3M20 16H7l3 3"/>',
  code: '<path d="m8 6-6 6 6 6M16 6l6 6-6 6"/>',
  sparkles: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>',
  palette: '<circle cx="12" cy="12" r="9"/><circle cx="8" cy="9" r="1"/><circle cx="12" cy="7" r="1"/><circle cx="16" cy="9" r="1"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/>',
  ai: '<path d="M12 3a4 4 0 0 0-4 4v1a3 3 0 0 0-1 5 3 3 0 0 0 2 4 3 3 0 0 0 6 0 3 3 0 0 0 2-4 3 3 0 0 0-1-5V7a4 4 0 0 0-4-4z"/><path d="M12 7v10"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/>',
  refresh: '<path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/>',
