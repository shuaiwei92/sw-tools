---
// 统一图标组件：传入 name 即可渲染对应内联 SVG（stroke 风格，跟随 currentColor）。
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls = '' } = Astro.props;

// 每个图标一段 path 数据；有新图标在这里追加即可。
const PATHS: Record<string, string> = {
  format: '<path d="M8 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h2M16 3h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-2"/>',
  minify: '<path d="M4 7h16M4 12h10M4 17h7"/>',
