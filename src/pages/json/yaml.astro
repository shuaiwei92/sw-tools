---
import Converter from '../../layouts/Converter.astro';
---

<Converter
  title="JSON ↔ YAML · sw-tools"
  description="JSON 与 YAML 双向转换，纯浏览器本地处理，不上传服务器。"
  toolName="JSON ↔ YAML"
  tree={true}
  inputPlaceholder="在此粘贴 JSON 或 YAML…（自动识别方向，失去焦点后转换）"
  outputLabel="输出"
>
  <label slot="input-tools" class="ml-1 flex items-center gap-1 text-xs text-slate-500">
    方向
    <select
      id="direction"
      class="rounded-md border border-slate-200 bg-white px-1.5 py-0.5 text-xs dark:border-slate-700 dark:bg-slate-900"
    >
      <option value="auto">自动</option>
      <option value="json2yaml">JSON → YAML</option>
      <option value="yaml2json">YAML → JSON</option>
    </select>
  </label>
</Converter>

<script>
  import { jsonToYaml, yamlToJson } from '../../lib/convert/jsonYaml';
  import { setupConverter } from '../../lib/convert/converter-ui';

  const SAMPLE_JSON = `{
  "name": "sw-tools",
  "private": true,
  "tools": ["formatter", "yaml"],
  "deps": { "astro": "^6.0.0", "yaml": "^2.0.0" }
}`;
  const SAMPLE_YAML = `name: sw-tools
private: true
tools:
  - formatter
  - yaml
deps:
  astro: "^6.0.0"
  yaml: "^2.0.0"`;

  // 自动识别方向：以 { 或 [ 开头且能解析为 JSON → JSON→YAML；否则 YAML→JSON
  function detectDir(input: string): string {
    const t = input.trim();
    if (/^[\{\[]/.test(t)) {
      try {
        JSON.parse(t);
        return 'json2yaml';
      } catch {
        /* 不是合法 JSON，按 YAML 处理 */
      }
    }
    return 'yaml2json';
  }

  setupConverter({
    tree: true,
    downloadName: 'result',
    convert: (input) => {
      const dir = (document.getElementById('direction') as HTMLSelectElement).value;
      return dir === 'yaml2json' ? yamlToJson(input) : jsonToYaml(input);
    },
    getDirection: () => (document.getElementById('direction') as HTMLSelectElement).value,
    detectDirection: detectDir,
    directionLabels: { json2yaml: 'JSON → YAML', yaml2json: 'YAML → JSON' },
    sampleFor: (dir) => (dir === 'yaml2json' ? SAMPLE_YAML : SAMPLE_JSON),
    sample: SAMPLE_JSON,
    getDownloadExt: () =>
      (document.getElementById('direction') as HTMLSelectElement).value === 'yaml2json' ? 'json' : 'yaml',
  });
</script>
