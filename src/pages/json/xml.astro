---
import Converter from '../../layouts/Converter.astro';
---

<Converter
  title="JSON ↔ XML · sw-tools"
  description="JSON 与 XML 双向转换（属性以 @_ 前缀表示），纯浏览器本地处理。"
  toolName="JSON ↔ XML"
  tree={true}
  inputPlaceholder="在此粘贴 JSON 或 XML…（自动识别方向，失去焦点后转换）"
  outputLabel="输出"
>
  <label slot="input-tools" class="ml-1 flex items-center gap-1 text-xs text-slate-500">
    方向
    <select
      id="direction"
      class="rounded-md border border-slate-200 bg-white px-1.5 py-0.5 text-xs dark:border-slate-700 dark:bg-slate-900"
    >
      <option value="auto">自动</option>
      <option value="json2xml">JSON → XML</option>
      <option value="xml2json">XML → JSON</option>
    </select>
  </label>
</Converter>

<script>
  import { jsonToXml, xmlToJson } from '../../lib/convert/jsonXml';
  import { setupConverter } from '../../lib/convert/converter-ui';

  const SAMPLE_JSON = `{
  "note": { "@id": "1", "to": "Tove", "from": "Jani", "heading": "Reminder", "body": "Don't forget me this weekend!" }
}`;
  const SAMPLE_XML = `<note id="1">
  <to>Tove</to>
  <from>Jani</from>
  <heading>Reminder</heading>
  <body>Don't forget me this weekend!</body>
</note>`;

  // 自动识别方向：以 < 开头视为 XML；否则视为 JSON
  function detectDir(input: string): string {
    const t = input.trim();
    if (!t) return 'json2xml';
    if (/^\s*</.test(t)) return 'xml2json';
    return 'json2xml';
  }

  setupConverter({
    tree: true,
    downloadName: 'result',
    convert: (input) => {
      const dir = (document.getElementById('direction') as HTMLSelectElement).value;
      return dir === 'xml2json' ? xmlToJson(input) : jsonToXml(input);
    },
    getDirection: () => (document.getElementById('direction') as HTMLSelectElement).value,
    detectDirection: detectDir,
    directionLabels: { json2xml: 'JSON → XML', xml2json: 'XML → JSON' },
    sampleFor: (dir) => (dir === 'xml2json' ? SAMPLE_XML : SAMPLE_JSON),
    sample: SAMPLE_JSON,
    getDownloadExt: () =>
      (document.getElementById('direction') as HTMLSelectElement).value === 'xml2json' ? 'json' : 'xml',
  });
</script>
