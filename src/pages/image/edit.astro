---
import Tool from '../../layouts/Tool.astro';
import Icon from '../../components/Icon.astro';
---

<Tool
  title="裁剪 / 翻转 / 旋转 · sw-tools"
  toolName="裁剪 / 翻转 / 旋转"
  description="拖拽裁剪、水平/垂直翻转、旋转 90°/180°/270°，全部在本地浏览器完成。"
  categoryHref="/#image"
  categoryName="图片处理"
  inputLabel="上传与操作"
  outputLabel="预览"
  columns="left-narrow"
>
  <div slot="input" class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-3">
    <!-- 拖拽上传 -->
    <label
      id="drop"
      class="flex min-h-24 cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-4 py-5 text-center transition hover:border-brand-500 hover:bg-brand-50/40 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-brand-400"
    >
      <Icon name="crop" size={24} class="text-slate-400" />
      <span class="text-sm font-medium text-slate-600 dark:text-slate-300">拖拽图片到此处，或点击选择文件</span>
      <span class="text-xs text-slate-400">支持 PNG / JPEG / WebP 等</span>
      <input id="file" type="file" accept="image/*" class="hidden" />
    </label>

    <!-- 工具条 -->
    <div class="flex flex-wrap gap-1.5">
      <button class="tool-btn tool-btn-sm" data-act="flip-h" title="水平翻转"><Icon name="flip" size={14} /><span>水平翻转</span></button>
      <button class="tool-btn tool-btn-sm" data-act="flip-v" title="垂直翻转"><Icon name="flip" size={14} class="rotate-90" /><span>垂直翻转</span></button>
      <span class="mx-1 h-5 w-px self-center bg-slate-200 dark:bg-slate-700"></span>
      <button class="tool-btn tool-btn-sm" data-act="rot-90" title="顺时针旋转 90°">↻ 90°</button>
      <button class="tool-btn tool-btn-sm" data-act="rot-180" title="旋转 180°">↻ 180°</button>
      <button class="tool-btn tool-btn-sm" data-act="rot-270" title="顺时针旋转 270°">↻ 270°</button>
      <span class="mx-1 h-5 w-px self-center bg-slate-200 dark:bg-slate-700"></span>
      <button class="tool-btn tool-btn-sm" data-act="apply-crop" title="将选框区域裁切为当前图"><Icon name="crop" size={14} /><span>应用裁剪</span></button>
      <button class="tool-btn tool-btn-sm" data-act="reset-sel" title="选框恢复为整图">整图选框</button>
      <button class="tool-btn tool-btn-sm" data-act="reset" title="恢复原始图片">重置</button>
    </div>

    <!-- 选框数值微调 -->
    <div class="grid grid-cols-2 gap-2 text-sm">
      <label class="flex items-center gap-1">X<input id="cx" type="number" min="0" class="w-full rounded-md border border-slate-200 px-1.5 py-1 text-sm outline-none focus:border-brand-500 dark:border-slate-700 dark:bg-slate-950" /></label>
      <label class="flex items-center gap-1">Y<input id="cy" type="number" min="0" class="w-full rounded-md border border-slate-200 px-1.5 py-1 text-sm outline-none focus:border-brand-500 dark:border-slate-700 dark:bg-slate-950" /></label>
      <label class="flex items-center gap-1">宽<input id="cw" type="number" min="1" class="w-full rounded-md border border-slate-200 px-1.5 py-1 text-sm outline-none focus:border-brand-500 dark:border-slate-700 dark:bg-slate-950" /></label>
      <label class="flex items-center gap-1">高<input id="ch" type="number" min="1" class="w-full rounded-md border border-slate-200 px-1.5 py-1 text-sm outline-none focus:border-brand-500 dark:border-slate-700 dark:bg-slate-950" /></label>
    </div>
    <span id="dims" class="font-mono text-xs text-slate-400"></span>

    <div id="status" class="text-xs text-slate-500" role="status" aria-live="polite"></div>
  </div>

  <button slot="output-tools" id="download" class="btn-primary tool-btn-sm" title="下载当前图片（PNG）">
    <Icon name="download" size={14} /><span>下载 PNG</span>
  </button>

  <div
    slot="output"
    id="stage-box"
    class="grid min-h-0 flex-1 place-items-center overflow-hidden bg-[repeating-conic-gradient(#e5e7eb_0deg_90deg,#fff_90deg_180deg)] bg-[length:16px_16px] p-3 dark:bg-[repeating-conic-gradient(#1e293b_0deg_90deg,#0f172a_90deg_180deg)]"
  >
    <div id="stage-empty" class="text-center text-sm text-slate-400">上传图片后，预览与选框将显示在此处</div>
    <div id="stage" class="relative hidden leading-none">
      <canvas id="preview" class="block"></canvas>
      <div id="sel" class="absolute cursor-move border-2 border-brand-500 bg-brand-500/10">
        <span id="sel-handle" class="absolute -bottom-1.5 -right-1.5 h-3 w-3 cursor-nwse-resize rounded-sm border border-white bg-brand-600"></span>
      </div>
    </div>
  </div>
</Tool>

<style>
  #sel { touch-action: none; }
</style>

<script>
  import {
    loadImage,
    imageToCanvas,
    flipCanvas,
    rotateCanvas,
    cropCanvas,
    download,
    outName,
  } from '../../lib/image/process';

  const drop = document.getElementById('drop') as HTMLLabelElement;
  const fileInput = document.getElementById('file') as HTMLInputElement;
  const stageBox = document.getElementById('stage-box') as HTMLDivElement;
  const stage = document.getElementById('stage') as HTMLDivElement;
  const stageEmpty = document.getElementById('stage-empty') as HTMLDivElement;
  const preview = document.getElementById('preview') as HTMLCanvasElement;
  const selEl = document.getElementById('sel') as HTMLDivElement;
  const handle = document.getElementById('sel-handle') as HTMLSpanElement;
  const cx = document.getElementById('cx') as HTMLInputElement;
  const cy = document.getElementById('cy') as HTMLInputElement;
  const cw = document.getElementById('cw') as HTMLInputElement;
  const ch = document.getElementById('ch') as HTMLInputElement;
  const dims = document.getElementById('dims') as HTMLSpanElement;
  const statusEl = document.getElementById('status') as HTMLDivElement;
  const downloadBtn = document.getElementById('download') as HTMLButtonElement;

  let work: HTMLCanvasElement | null = null;
  let original: HTMLCanvasElement | null = null;
  let originalName = 'image';
  let sel = { x: 0, y: 0, w: 0, h: 0 };

  // 拖拽状态
  let drag: 'move' | 'resize' | null = null;
  let startPX = 0;
  let startPY = 0;
  let startSel = { ...sel };

  function setStatus(msg: string, ok = true) {
    statusEl.textContent = msg;
    statusEl.className = `text-xs ${ok ? 'text-slate-500' : 'text-red-600'}`;
  }

  function cloneCanvas(src: HTMLCanvasElement): HTMLCanvasElement {
    const c = document.createElement('canvas');
    c.width = src.width;
    c.height = src.height;
    c.getContext('2d')!.drawImage(src, 0, 0);
    return c;
  }

  function dispScale(): number {
    if (!preview.width) return 1;
    return preview.clientWidth / preview.width;
  }

  /** 把画布显示尺寸缩放到适配右栏容器（保持宽高比，整图可见）。 */
  function fitPreview() {
    if (!work) return;
    const availW = Math.max(1, stageBox.clientWidth - 24);
    const availH = Math.max(1, stageBox.clientHeight - 24);
    const scale = Math.min(availW / work.width, availH / work.height, 1);
    preview.style.width = `${Math.max(1, Math.round(work.width * scale))}px`;
    preview.style.height = `${Math.max(1, Math.round(work.height * scale))}px`;
    updateOverlay();
  }

  function resetSel() {
    if (!work) return;
    sel = { x: 0, y: 0, w: work.width, h: work.height };
    syncInputs();
    updateOverlay();
  }

  function syncInputs() {
    cx.value = String(Math.round(sel.x));
    cy.value = String(Math.round(sel.y));
    cw.value = String(Math.round(sel.w));
    ch.value = String(Math.round(sel.h));
  }

  function updateOverlay() {
    const s = dispScale();
    selEl.style.left = `${sel.x * s}px`;
    selEl.style.top = `${sel.y * s}px`;
    selEl.style.width = `${sel.w * s}px`;
    selEl.style.height = `${sel.h * s}px`;
  }

  function render() {
    if (!work) return;
    preview.width = work.width;
    preview.height = work.height;
    preview.getContext('2d')!.drawImage(work, 0, 0);
    dims.textContent = `当前 ${work.width} × ${work.height} px`;
    fitPreview();
  }

  function clamp(v: number, min: number, max: number) {
    return Math.max(min, Math.min(max, v));
  }

  function onFile(file: File) {
    if (!file) return;
    setStatus('正在读取图片…');
    loadImage(file)
      .then((img) => {
        work = imageToCanvas(img);
        original = cloneCanvas(work);
        originalName = file.name;
        stageEmpty.classList.add('hidden');
        stage.classList.remove('hidden');
        resetSel();
        render();
        setStatus('已载入，可拖拽选框裁剪或翻转 / 旋转');
      })
      .catch((e: Error) => setStatus(e.message, false));
  }

  // ---- 变换 ----
  function applyFlip(h: boolean, v: boolean) {
    if (!work) return;
    work = flipCanvas(work, h, v);
    resetSel();
    render();
  }
  function applyRotate(deg: number) {
    if (!work) return;
    work = rotateCanvas(work, deg);
    resetSel();
    render();
  }
  function applyCrop() {
    if (!work) return;
    work = cropCanvas(work, sel.x, sel.y, sel.w, sel.h);
    resetSel();
    render();
    setStatus('已裁剪');
  }
  function resetAll() {
    if (!original) return;
    work = cloneCanvas(original);
    resetSel();
    render();
    setStatus('已恢复原始图片');
  }

  // ---- 选框拖拽 ----
  selEl.addEventListener('pointerdown', (e) => {
    if (e.target === handle) return; // 手柄单独处理
    drag = 'move';
    startPX = e.clientX;
    startPY = e.clientY;
    startSel = { ...sel };
    selEl.setPointerCapture(e.pointerId);
    e.preventDefault();
  });
  handle.addEventListener('pointerdown', (e) => {
    drag = 'resize';
    startPX = e.clientX;
    startPY = e.clientY;
    startSel = { ...sel };
    handle.setPointerCapture(e.pointerId);
    e.stopPropagation();
    e.preventDefault();
  });
  function onPointerMove(e: PointerEvent) {
    if (!drag || !work) return;
    const s = dispScale();
    const dx = (e.clientX - startPX) / s;
    const dy = (e.clientY - startPY) / s;
    if (drag === 'move') {
      sel.x = clamp(startSel.x + dx, 0, work.width - sel.w);
      sel.y = clamp(startSel.y + dy, 0, work.height - sel.h);
    } else {
      sel.w = clamp(startSel.w + dx, 1, work.width - sel.x);
      sel.h = clamp(startSel.h + dy, 1, work.height - sel.y);
    }
    syncInputs();
    updateOverlay();
  }
  function onPointerUp(e: PointerEvent) {
    drag = null;
    try { (e.target as Element).releasePointerCapture?.(e.pointerId); } catch {}
  }
  selEl.addEventListener('pointermove', onPointerMove);
  handle.addEventListener('pointermove', onPointerMove);
  selEl.addEventListener('pointerup', onPointerUp);
  handle.addEventListener('pointerup', onPointerUp);
  window.addEventListener('resize', fitPreview);

  // ---- 数值微调 ----
  function applyInputs() {
    if (!work) return;
    const x = clamp(Number(cx.value) || 0, 0, work.width);
    const y = clamp(Number(cy.value) || 0, 0, work.height);
    const w = clamp(Number(cw.value) || 1, 1, work.width - x);
    const h = clamp(Number(ch.value) || 1, 1, work.height - y);
    sel = { x, y, w, h };
    syncInputs();
    updateOverlay();
  }
  [cx, cy, cw, ch].forEach((el) => el.addEventListener('input', applyInputs));

  // ---- 工具条 ----
  document.querySelectorAll('[data-act]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const act = (btn as HTMLElement).dataset.act;
      if (act === 'flip-h') applyFlip(true, false);
      else if (act === 'flip-v') applyFlip(false, true);
      else if (act === 'rot-90') applyRotate(90);
      else if (act === 'rot-180') applyRotate(180);
      else if (act === 'rot-270') applyRotate(270);
      else if (act === 'apply-crop') applyCrop();
      else if (act === 'reset-sel') resetSel();
      else if (act === 'reset') resetAll();
    });
  });

  // ---- 下载 ----
  downloadBtn.addEventListener('click', () => {
    if (!work) return;
    preview.toBlob((b) => {
      if (b) download(b, outName(originalName, 'image/png'));
    }, 'image/png');
  });

  // ---- 拖拽上传 ----
  ['dragover', 'dragenter'].forEach((ev) =>
    drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.add('border-brand-500', 'bg-brand-50/60');
    })
  );
  ['dragleave', 'drop'].forEach((ev) =>
    drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.remove('border-brand-500', 'bg-brand-50/60');
    })
  );
  drop.addEventListener('drop', (e) => {
    const f = (e as DragEvent).dataTransfer?.files?.[0];
    if (f) onFile(f);
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.[0]) onFile(fileInput.files[0]);
  });
</script>
