---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

const CATEGORY = { href: '/#image', name: '图片处理' };
const TOOL = '图片压缩';
---

<Base title={`${TOOL} · sw-tools`} description="按质量与最大宽度压缩图片，全部在本地浏览器完成，不上传服务器。">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-4">
    <div>
      <h1 class="text-xl font-bold">{TOOL}</h1>
      <nav class="mt-1 flex items-center gap-1.5 text-xs" aria-label="面包屑">
        <a href="/" class="cursor-pointer text-brand-600 transition hover:text-brand-700 hover:underline underline-offset-2" title="返回首页">首页</a>
        <span class="text-slate-300 dark:text-slate-600">/</span>
        <a href={CATEGORY.href} class="cursor-pointer text-slate-400 transition hover:text-brand-600 hover:underline underline-offset-2 dark:text-slate-500" title="查看分类下全部工具">{CATEGORY.name}</a>
        <span class="text-slate-300 dark:text-slate-600">/</span>
        <span class="cursor-default font-medium text-slate-700 dark:text-slate-200">{TOOL}</span>
      </nav>
      <p class="mt-2 text-sm text-slate-500">
        降低质量或限制最大宽度即可减小体积，压缩过程完全在本地完成。PNG 为无损格式，主要经「限制宽度」减小体积；JPEG / WebP 还可调质量。
      </p>
    </div>

    <label
      id="drop"
      class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-4 py-10 text-center transition hover:border-brand-500 hover:bg-brand-50/40 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-brand-400"
    >
      <Icon name="compress" size={28} class="text-slate-400" />
      <span class="text-sm font-medium text-slate-600 dark:text-slate-300">拖拽图片到此处，或点击选择文件</span>
      <span class="text-xs text-slate-400">支持 PNG / JPEG / WebP 等</span>
      <input id="file" type="file" accept="image/*" class="hidden" />
    </label>

    <div id="workspace" class="hidden flex-col gap-4">
      <div class="flex flex-wrap items-end gap-4 rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <label id="quality-wrap" class="flex flex-col gap-1 text-sm">
          <span class="font-medium text-slate-600 dark:text-slate-300">质量：<span id="quality-val">80</span></span>
          <input id="quality" type="range" min="1" max="100" value="80" class="w-44 accent-brand-600" />
        </label>
        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium text-slate-600 dark:text-slate-300">最大宽度（像素，留空=不限制）</span>
          <input id="maxw" type="number" min="1" placeholder="如 1280" class="w-36 rounded-md border border-slate-200 bg-white px-2 py-1.5 text-sm outline-none focus:border-brand-500 dark:border-slate-700 dark:bg-slate-950" />
        </label>
        <button id="download" class="tool-btn ml-auto" title="下载压缩后的图片">
          <Icon name="download" size={16} /><span>下载</span>
        </button>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <div class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
          <span class="text-sm font-semibold text-slate-600 dark:text-slate-300">预览（压缩结果）</span>
          <div class="grid flex-1 place-items-center overflow-hidden rounded-lg border border-slate-100 bg-[repeating-conic-gradient(#e5e7eb_0deg_90deg,#fff_90deg_180deg)] bg-[length:16px_16px] p-2 dark:border-slate-800 dark:bg-[repeating-conic-gradient(#1e293b_0deg_90deg,#0f172a_90deg_180deg)]">
            <img id="preview" alt="压缩预览" class="max-h-[50vh] max-w-full rounded" />
          </div>
        </div>
        <div class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-white p-4 text-sm dark:border-slate-800 dark:bg-slate-900">
          <span class="font-semibold text-slate-600 dark:text-slate-300">信息</span>
          <div class="flex justify-between border-b border-slate-100 py-1.5 dark:border-slate-800">
            <span class="text-slate-500">原始尺寸</span>
            <span id="info-dims" class="font-mono text-slate-700 dark:text-slate-200">—</span>
          </div>
          <div class="flex justify-between border-b border-slate-100 py-1.5 dark:border-slate-800">
            <span class="text-slate-500">原始体积</span>
            <span id="info-orig" class="font-mono text-slate-700 dark:text-slate-200">—</span>
          </div>
          <div class="flex justify-between border-b border-slate-100 py-1.5 dark:border-slate-800">
            <span class="text-slate-500">输出体积</span>
            <span id="info-out" class="font-mono text-slate-700 dark:text-slate-200">—</span>
          </div>
          <div class="flex justify-between py-1.5">
            <span class="text-slate-500">压缩比例</span>
            <span id="info-ratio" class="font-mono font-semibold text-slate-700 dark:text-slate-200">—</span>
          </div>
        </div>
      </div>
    </div>

    <div id="status" class="h-5 text-sm text-slate-500" role="status" aria-live="polite"></div>
  </div>
</Base>

<script>
  import {
    loadImage,
    imageToCanvas,
    canvasToBlob,
    resizeCanvas,
    download,
    formatBytes,
    extForType,
    outName,
    type ImageOutFormat,
  } from '../../lib/image/process';

  const drop = document.getElementById('drop') as HTMLLabelElement;
  const fileInput = document.getElementById('file') as HTMLInputElement;
  const workspace = document.getElementById('workspace') as HTMLDivElement;
  const qualityWrap = document.getElementById('quality-wrap') as HTMLLabelElement;
  const quality = document.getElementById('quality') as HTMLInputElement;
  const qualityVal = document.getElementById('quality-val') as HTMLSpanElement;
  const maxw = document.getElementById('maxw') as HTMLInputElement;
  const downloadBtn = document.getElementById('download') as HTMLButtonElement;
  const preview = document.getElementById('preview') as HTMLImageElement;
  const infoDims = document.getElementById('info-dims') as HTMLSpanElement;
  const infoOrig = document.getElementById('info-orig') as HTMLSpanElement;
  const infoOut = document.getElementById('info-out') as HTMLSpanElement;
  const infoRatio = document.getElementById('info-ratio') as HTMLSpanElement;
  const statusEl = document.getElementById('status') as HTMLDivElement;

  let canvas: HTMLCanvasElement | null = null;
  let originalBytes = 0;
  let originalName = 'image';
  let outFmt: ImageOutFormat = 'image/png';
  let lastBlob: Blob | null = null;
  let lastUrl = '';

  function setStatus(msg: string, ok = true) {
    statusEl.textContent = msg;
    statusEl.className = `h-5 text-sm ${ok ? 'text-slate-500' : 'text-red-600'}`;
  }

  function isLossy(fmt: string) {
    return fmt === 'image/jpeg' || fmt === 'image/webp';
  }

  async function render() {
    if (!canvas) return;
    const q = Number(quality.value) / 100;
    const mw = maxw.value ? Math.max(1, parseInt(maxw.value, 10)) : 0;
    let src = mw ? resizeCanvas(canvas, mw) : canvas;
    const blob = await canvasToBlob(src, outFmt, isLossy(outFmt) ? q : undefined);
    lastBlob = blob;
    if (lastUrl) URL.revokeObjectURL(lastUrl);
    lastUrl = URL.createObjectURL(blob);
    preview.src = lastUrl;
    infoOut.textContent = formatBytes(blob.size);
    const ratio = (1 - blob.size / originalBytes) * 100;
    infoRatio.textContent = `${ratio.toFixed(1)}% 减小`;
    infoRatio.className = `font-mono font-semibold ${ratio >= 0 ? 'text-emerald-600' : 'text-amber-600'}`;
  }

  function onFile(file: File) {
    if (!file) return;
    setStatus('正在读取图片…');
    loadImage(file)
      .then((img) => {
        canvas = imageToCanvas(img);
        originalBytes = file.size;
        originalName = file.name;
        // 输出格式尽量保持原格式（GIF/BMP 等无法编码的统一转 PNG）
        outFmt = (['image/png', 'image/jpeg', 'image/webp'] as string[]).includes(file.type)
          ? (file.type as ImageOutFormat)
          : 'image/png';
        infoDims.textContent = `${canvas.width} × ${canvas.height}`;
        infoOrig.textContent = formatBytes(file.size);
        workspace.classList.remove('hidden');
        workspace.classList.add('flex');
        // PNG 无损：质量滑块无意义
        const lossy = isLossy(outFmt);
        qualityWrap.classList.toggle('hidden', !lossy);
        qualityWrap.classList.toggle('flex', lossy);
        setStatus(`已载入（输出格式 ${extForType(outFmt).toUpperCase()}）`);
        return render();
      })
      .catch((e: Error) => setStatus(e.message, false));
  }

  ['dragover', 'dragenter'].forEach((ev) =>
    drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.add('border-brand-500', 'bg-brand-50/60');
    })
  );
  ['dragleave', 'drop'].forEach((ev) =>
    drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.remove('border-brand-500', 'bg-brand-50/60');
    })
  );
  drop.addEventListener('drop', (e) => {
    const f = (e as DragEvent).dataTransfer?.files?.[0];
    if (f) onFile(f);
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.[0]) onFile(fileInput.files[0]);
  });

  quality.addEventListener('input', () => {
    qualityVal.textContent = quality.value;
    render();
  });
  maxw.addEventListener('input', render);
  downloadBtn.addEventListener('click', () => {
    if (!lastBlob) return;
    download(lastBlob, outName(originalName, outFmt));
  });
</script>
