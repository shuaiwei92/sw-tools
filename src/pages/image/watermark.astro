---
import Tool from '../../layouts/Tool.astro';
import Icon from '../../components/Icon.astro';
---

<Tool
  title="图片水印淡化 · sw-tools"
  toolName="图片水印淡化"
  description="涂抹水印区域后用本地插值算法将其淡化弱化，纯浏览器处理、图片不上传。"
  categoryHref="/#image"
  categoryName="图片处理"
  inputLabel="上传与操作"
  outputLabel="预览"
  columns="left-narrow"
>
  <div slot="input" class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-3">
    <!-- 拖拽上传 -->
    <label
      id="drop"
      class="flex min-h-24 cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-4 py-5 text-center transition hover:border-brand-500 hover:bg-brand-50/40 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-brand-400"
    >
      <Icon name="watermark" size={24} class="text-slate-400" />
      <span class="text-sm font-medium text-slate-600 dark:text-slate-300">拖拽图片到此处，或点击选择文件</span>
      <span class="text-xs text-slate-400">支持 PNG / JPEG / WebP 等</span>
      <input id="file" type="file" accept="image/*" class="hidden" />
    </label>

    <!-- 工具条 -->
    <div class="flex flex-col gap-3">
      <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
        笔刷
        <input id="brush" type="range" min="4" max="160" value="40" class="w-full accent-brand-600" />
        <span id="brushVal" class="w-12 shrink-0 text-right font-mono text-xs text-slate-400">40px</span>
      </label>
      <div class="flex flex-wrap gap-1.5">
        <button class="tool-btn tool-btn-sm" id="undo" title="撤销上一笔涂抹">撤销</button>
        <button class="tool-btn tool-btn-sm" id="clearMask" title="清除所有涂抹">清除涂抹</button>
        <span class="mx-1 h-5 w-px self-center bg-slate-200 dark:bg-slate-700"></span>
        <button class="tool-btn tool-btn-sm" id="apply" title="对涂抹区域进行修复"><Icon name="sparkles" size={14} /><span>应用修复</span></button>
        <button class="tool-btn tool-btn-sm" id="reset" title="恢复原始图片">重置</button>
      </div>
    </div>

    <p class="text-xs leading-relaxed text-slate-400">
      提示：用鼠标 / 触摸在水印上涂抹，涂抹区域以红色半透明显示。修复效果取决于背景复杂度，纯色 / 渐变背景最佳。
    </p>
    <div id="status" class="text-xs text-slate-500" role="status" aria-live="polite"></div>
  </div>

  <button slot="output-tools" id="download" class="btn-primary tool-btn-sm" title="下载修复后的图片（PNG）">
    <Icon name="download" size={14} /><span>下载 PNG</span>
  </button>

  <div
    slot="output"
    id="stage-box"
    class="grid min-h-0 flex-1 place-items-center overflow-hidden bg-[repeating-conic-gradient(#e5e7eb_0deg_90deg,#fff_90deg_180deg)] bg-[length:16px_16px] p-3 dark:bg-[repeating-conic-gradient(#1e293b_0deg_90deg,#0f172a_90deg_180deg)]"
  >
    <div id="stage-empty" class="text-center text-sm text-slate-400">上传图片后，涂抹预览将显示在此处</div>
    <div id="stage" class="relative hidden leading-none">
      <canvas id="preview" class="block"></canvas>
      <canvas id="mask" class="absolute inset-0 h-full w-full cursor-crosshair touch-none"></canvas>
    </div>
  </div>
</Tool>

<style>
  #mask { touch-action: none; }
</style>

<script>
  import { loadImage, imageToCanvas, download, outName } from '../../lib/image/process';
  import { inpaint } from '../../lib/image/watermark';

  const drop = document.getElementById('drop') as HTMLLabelElement;
  const fileInput = document.getElementById('file') as HTMLInputElement;
  const stageBox = document.getElementById('stage-box') as HTMLDivElement;
  const stage = document.getElementById('stage') as HTMLDivElement;
  const stageEmpty = document.getElementById('stage-empty') as HTMLDivElement;
  const preview = document.getElementById('preview') as HTMLCanvasElement;
  const maskCanvas = document.getElementById('mask') as HTMLCanvasElement;
  const maskCtx = maskCanvas.getContext('2d')!;
  const brush = document.getElementById('brush') as HTMLInputElement;
  const brushVal = document.getElementById('brushVal') as HTMLSpanElement;
  const statusEl = document.getElementById('status') as HTMLDivElement;
  const undoBtn = document.getElementById('undo') as HTMLButtonElement;
  const clearBtn = document.getElementById('clearMask') as HTMLButtonElement;
  const applyBtn = document.getElementById('apply') as HTMLButtonElement;
  const resetBtn = document.getElementById('reset') as HTMLButtonElement;
  const downloadBtn = document.getElementById('download') as HTMLButtonElement;

  let work: HTMLCanvasElement | null = null;
  let original: HTMLCanvasElement | null = null;
  let originalName = 'image';
  let W = 0, H = 0;
  let maskData = new Uint8Array(0);
  let undoStack: Uint8Array[] = [];
  let brushSize = Number(brush.value);
  let drawing = false;
  let lastX: number | null = null;
  let lastY: number | null = null;

  function setStatus(msg: string, ok = true) {
    statusEl.textContent = msg;
    statusEl.className = `text-xs ${ok ? 'text-slate-500' : 'text-red-600'}`;
  }

  function cloneCanvas(src: HTMLCanvasElement): HTMLCanvasElement {
    const c = document.createElement('canvas');
    c.width = src.width;
    c.height = src.height;
    c.getContext('2d')!.drawImage(src, 0, 0);
    return c;
  }

  /** 把画布显示尺寸缩放到适配右栏容器（保持宽高比，整图可见）。 */
  function fitPreview() {
    if (!work) return;
    const availW = Math.max(1, stageBox.clientWidth - 24);
    const availH = Math.max(1, stageBox.clientHeight - 24);
    const scale = Math.min(availW / work.width, availH / work.height, 1);
    preview.style.width = `${Math.max(1, Math.round(work.width * scale))}px`;
    preview.style.height = `${Math.max(1, Math.round(work.height * scale))}px`;
  }

  function render() {
    if (!work) return;
    preview.width = work.width;
    preview.height = work.height;
    preview.getContext('2d')!.drawImage(work, 0, 0);
    fitPreview();
  }

  // 在 (cx,cy) 处落一笔：同时更新涂抹画布与 maskData
  function paintAt(cx: number, cy: number) {
    const r = brushSize;
    maskCtx.fillStyle = 'rgba(239,68,68,0.45)';
    maskCtx.beginPath();
    maskCtx.arc(cx, cy, r, 0, Math.PI * 2);
    maskCtx.fill();
    const x0 = Math.max(0, Math.floor(cx - r));
    const x1 = Math.min(W - 1, Math.ceil(cx + r));
    const y0 = Math.max(0, Math.floor(cy - r));
    const y1 = Math.min(H - 1, Math.ceil(cy + r));
    const r2 = r * r;
    for (let y = y0; y <= y1; y++) {
      for (let x = x0; x <= x1; x++) {
        const dx = x - cx, dy = y - cy;
        if (dx * dx + dy * dy <= r2) maskData[y * W + x] = 1;
      }
    }
  }

  // 在两点之间插值落笔，避免快速拖动出现断点
  function strokeTo(px: number, py: number) {
    if (lastX === null || lastY === null) {
      paintAt(px, py);
    } else {
      const dist = Math.hypot(px - lastX, py - lastY);
      const steps = Math.max(1, Math.ceil(dist / (brushSize * 0.4)));
      for (let i = 1; i <= steps; i++) {
        const t = i / steps;
        paintAt(lastX + (px - lastX) * t, lastY + (py - lastY) * t);
      }
    }
    lastX = px;
    lastY = py;
  }

  function toCanvas(e: PointerEvent) {
    const rect = maskCanvas.getBoundingClientRect();
    const sx = maskCanvas.width / rect.width;
    const sy = maskCanvas.height / rect.height;
    return { x: (e.clientX - rect.left) * sx, y: (e.clientY - rect.top) * sy };
  }

  function redrawMask() {
    const img = maskCtx.createImageData(W, H);
    for (let i = 0; i < W * H; i++) {
      if (maskData[i]) {
        img.data[i * 4] = 239;
        img.data[i * 4 + 1] = 68;
        img.data[i * 4 + 2] = 68;
        img.data[i * 4 + 3] = 115;
      }
    }
    maskCtx.putImageData(img, 0, 0);
  }

  function clearMask() {
    maskData = new Uint8Array(W * H);
    undoStack = [];
    maskCtx.clearRect(0, 0, W, H);
  }

  function onFile(file: File) {
    if (!file) return;
    setStatus('正在读取图片…');
    loadImage(file)
      .then((img) => {
        work = imageToCanvas(img);
        original = cloneCanvas(work);
        originalName = file.name;
        W = work.width;
        H = work.height;
        preview.width = W;
        preview.height = H;
        maskCanvas.width = W;
        maskCanvas.height = H;
        clearMask();
        stageEmpty.classList.add('hidden');
        stage.classList.remove('hidden');
        render();
        setStatus(`已载入 ${W} × ${H} px，请在水印区域涂抹`);
      })
      .catch((e: Error) => setStatus(e.message, false));
  }

  function applyInpaint() {
    if (!work) return;
    let count = 0;
    for (let i = 0; i < maskData.length; i++) if (maskData[i]) count++;
    if (!count) {
      setStatus('请先在水印区域涂抹', false);
      return;
    }
    setStatus('正在修复…');
    // 让出主线程以刷新状态文案
    setTimeout(() => {
      const ctx = work!.getContext('2d')!;
      const imgData = ctx.getImageData(0, 0, W, H);
      const result = inpaint(imgData, maskData, 40);
      ctx.putImageData(result, 0, 0);
      clearMask();
      render();
      setStatus(`已修复 ${count} 个像素区域`);
    }, 20);
  }

  function resetAll() {
    if (!original) return;
    work = cloneCanvas(original);
    clearMask();
    render();
    setStatus('已恢复原始图片');
  }

  // ---- 笔刷涂抹 ----
  maskCanvas.addEventListener('pointerdown', (e) => {
    if (!work) return;
    undoStack.push(maskData.slice());
    if (undoStack.length > 8) undoStack.shift();
    drawing = true;
    lastX = null;
    lastY = null;
    maskCanvas.setPointerCapture(e.pointerId);
    const p = toCanvas(e);
    strokeTo(p.x, p.y);
    e.preventDefault();
  });
  maskCanvas.addEventListener('pointermove', (e) => {
    if (!drawing) return;
    const p = toCanvas(e);
    strokeTo(p.x, p.y);
  });
  function endStroke() {
    drawing = false;
    lastX = null;
    lastY = null;
  }
  maskCanvas.addEventListener('pointerup', endStroke);
  maskCanvas.addEventListener('pointercancel', endStroke);

  // ---- 工具条 ----
  brush.addEventListener('input', () => {
    brushSize = Number(brush.value);
    brushVal.textContent = `${brushSize}px`;
  });
  undoBtn.addEventListener('click', () => {
    if (!undoStack.length) {
      setStatus('没有可撤销的操作');
      return;
    }
    maskData = undoStack.pop()!;
    redrawMask();
    setStatus('已撤销上一笔');
  });
  clearBtn.addEventListener('click', () => {
    clearMask();
    setStatus('已清除涂抹');
  });
  applyBtn.addEventListener('click', applyInpaint);
  resetBtn.addEventListener('click', resetAll);

  downloadBtn.addEventListener('click', () => {
    if (!work) return;
    preview.toBlob((b) => {
      if (b) download(b, outName(originalName, 'image/png'));
    }, 'image/png');
  });

  // ---- 拖拽上传 ----
  ['dragover', 'dragenter'].forEach((ev) =>
    drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.add('border-brand-500', 'bg-brand-50/60');
    })
  );
  ['dragleave', 'drop'].forEach((ev) =>
    drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.remove('border-brand-500', 'bg-brand-50/60');
    })
  );
  drop.addEventListener('drop', (e) => {
    const f = (e as DragEvent).dataTransfer?.files?.[0];
    if (f) onFile(f);
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.[0]) onFile(fileInput.files[0]);
  });
</script>
