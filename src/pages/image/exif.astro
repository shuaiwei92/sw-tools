---
import Tool from '../../layouts/Tool.astro';
---
<Tool
  title="图片隐私元数据清除 · sw-tools"
  toolName="图片隐私元数据清除"
  description="无损剥离 JPEG 的 Exif/IPTC 与 PNG 的文本块（相机型号、GPS、拍摄时间等），保护隐私，本地处理不上传。"
  categoryHref="/#image"
  categoryName="图片处理"
  inputLabel="选择图片"
  outputLabel="元数据与结果"
  columns="left-narrow"
>
  <div slot="input" class="flex min-h-0 flex-1 flex-col gap-3 p-3">
    <div
      id="drop"
      class="flex min-h-[10rem] flex-1 cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 text-center text-slate-400 transition hover:border-brand-400 hover:text-brand-500 dark:border-slate-600"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M5 20h14"/></svg>
      <p class="text-sm">点击或拖拽图片到此处</p>
      <p class="text-[11px]">支持 JPEG / PNG，最大约 20 MB</p>
      <input id="file" type="file" accept="image/jpeg,image/png" class="hidden" />
    </div>
    <div id="preview-wrap" class="hidden">
      <p class="mb-1 text-xs text-slate-500 dark:text-slate-400">原图预览</p>
      <img id="preview" class="max-h-40 w-full rounded-lg border border-slate-200 object-contain dark:border-slate-700" alt="原图预览" />
    </div>
  </div>

  <div slot="output-tools" class="flex flex-wrap items-center gap-1.5">
    <button id="clear-btn" class="tool-btn tool-btn-sm" disabled title="清除并下载">清除并下载</button>
  </div>

  <div slot="output" class="flex min-h-0 flex-1 flex-col gap-3 p-3">
    <div id="info" class="text-sm">
      <p class="text-slate-400">选择图片后，这里会显示检测到的元数据与清除结果。</p>
    </div>
    <div id="result" class="hidden rounded-lg border border-slate-200 p-3 text-sm dark:border-slate-700">
      <div class="grid grid-cols-2 gap-2">
        <div><div class="text-xs text-slate-400">原始大小</div><div id="orig-size" class="font-mono">—</div></div>
        <div><div class="text-xs text-slate-400">清除后大小</div><div id="clean-size" class="font-mono">—</div></div>
      </div>
      <div class="mt-3">
        <div class="text-xs text-slate-400">已移除</div>
        <div id="removed" class="mt-1 flex flex-wrap gap-1"></div>
      </div>
    </div>
  </div>
</Tool>

<script>
  import { stripImageMetadata, summarizeMetadata, detectFormat } from '../../lib/image/exif';

  const drop = document.getElementById('drop') as HTMLDivElement;
  const fileInput = document.getElementById('file') as HTMLInputElement;
  const previewWrap = document.getElementById('preview-wrap') as HTMLDivElement;
  const preview = document.getElementById('preview') as HTMLImageElement;
  const info = document.getElementById('info') as HTMLDivElement;
  const result = document.getElementById('result') as HTMLDivElement;
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
  const origSize = document.getElementById('orig-size') as HTMLDivElement;
  const cleanSize = document.getElementById('clean-size') as HTMLDivElement;
  const removedEl = document.getElementById('removed') as HTMLDivElement;

  let currentBuf: Uint8Array | null = null;
  let currentName = 'image';
  let currentMime = 'image/jpeg';
  let currentUrl: string | null = null;

  const fmtSize = (n: number) => (n >= 1024 ? (n / 1024).toFixed(1) + ' KB' : n + ' B');

  function loadFile(file: File) {
    if (!file.type.includes('jpeg') && !file.type.includes('png') && !/\.(jpe?g|png)$/i.test(file.name)) {
      info.innerHTML = '<p class="text-rose-500">不支持的格式，仅支持 JPEG / PNG。</p>';
      return;
    }
    currentName = file.name;
    currentMime = file.type || (/\.png$/i.test(file.name) ? 'image/png' : 'image/jpeg');
    const reader = new FileReader();
    reader.onload = () => {
      const buf = new Uint8Array(reader.result as ArrayBuffer);
      currentBuf = buf;
      const summary = summarizeMetadata(buf);
      if (summary.format === 'unknown') {
        info.innerHTML = '<p class="text-rose-500">无法识别为 JPEG / PNG，可能文件已损坏或格式不支持。</p>';
        clearBtn.disabled = true;
        return;
      }
      const foundTxt = summary.found.length
        ? summary.found.map((f) => `<span class="rounded bg-amber-100 px-1.5 py-0.5 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">${f}</span>`).join(' ')
        : '<span class="text-slate-400">未检测到可清除的元数据</span>';
      info.innerHTML = `
        <div class="mb-2 flex flex-wrap gap-2 text-xs">
          <span class="rounded bg-slate-100 px-1.5 py-0.5 dark:bg-slate-800">格式：${summary.format.toUpperCase()}</span>
          <span class="rounded bg-slate-100 px-1.5 py-0.5 dark:bg-slate-800">大小：${fmtSize(buf.length)}</span>
        </div>
        <div class="text-xs text-slate-400">检测到的元数据</div>
        <div class="mt-1 flex flex-wrap gap-1">${foundTxt}</div>`;
      clearBtn.disabled = false;
      if (summary.hasMetadata) {
        clearBtn.textContent = '清除并下载';
      } else {
        clearBtn.textContent = '无元数据可清除';
        clearBtn.disabled = true;
      }
      // 预览
      if (currentUrl) URL.revokeObjectURL(currentUrl);
      currentUrl = URL.createObjectURL(file);
      preview.src = currentUrl;
      previewWrap.classList.remove('hidden');
      result.classList.add('hidden');
    };
    reader.readAsArrayBuffer(file);
  }

  function doClear() {
    if (!currentBuf) return;
    const r = stripImageMetadata(currentBuf);
    if (r.format === 'unknown') {
      info.innerHTML = '<p class="text-rose-500">不支持的格式，无法清除。</p>';
      return;
    }
    origSize.textContent = fmtSize(r.originalSize);
    cleanSize.textContent = fmtSize(r.cleanedSize);
    removedEl.innerHTML = r.removed.length
      ? r.removed.map((x) => `<span class="rounded bg-emerald-100 px-1.5 py-0.5 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">${x}</span>`).join(' ')
      : '<span class="text-slate-400">无</span>';
    result.classList.remove('hidden');

    const blob = new Blob([r.cleaned], { type: currentMime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'cleaned-' + currentName.replace(/(\.[^.]+)?$/, '') + (currentMime.includes('png') ? '.png' : '.jpg');
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  drop.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) loadFile(fileInput.files[0]);
  });
  ['dragover', 'dragenter'].forEach((ev) =>
    drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.add('border-brand-500', 'text-brand-500');
    }),
  );
  ['dragleave', 'drop'].forEach((ev) =>
    drop.addEventListener(ev, (e) => {
      e.preventDefault();
      drop.classList.remove('border-brand-500', 'text-brand-500');
    }),
  );
  drop.addEventListener('drop', (e) => {
    const dt = (e as DragEvent).dataTransfer;
    if (dt && dt.files && dt.files[0]) loadFile(dt.files[0]);
  });
  clearBtn.addEventListener('click', doClear);
</script>
