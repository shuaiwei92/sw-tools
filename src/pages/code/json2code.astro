---
import Tool from '../../layouts/Tool.astro';
import type { TargetLang } from '../../lib/code/json2code';

const LANGS: { id: TargetLang; name: string; ext: string }[] = [
  { id: 'typescript', name: 'TypeScript', ext: 'ts' },
  { id: 'go', name: 'Go', ext: 'go' },
  { id: 'java', name: 'Java', ext: 'java' },
  { id: 'csharp', name: 'C#', ext: 'cs' },
  { id: 'python', name: 'Python', ext: 'py' },
];
---

<Tool
  title="JSON 转实体 · sw-tools"
  toolName="JSON 转实体"
  description="把 JSON 自动转换为 TypeScript 接口 / Go struct / Java / C# / Python 数据类，嵌套对象自动拆分命名。"
  categoryHref="/#code"
  categoryName="代码工具"
  inputLabel="JSON 输入"
  outputLabel="生成的代码"
  columns="even"
>
  <div slot="input-tools" class="flex items-center gap-1.5" id="lang-tabs">
    {LANGS.map((l, i) => (
      <button
        class:list={[
          'rounded-md px-2 py-0.5 text-xs transition',
          i === 0
            ? 'bg-brand-600 text-white'
            : 'text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800',
        ]}
        data-lang={l.id}
        data-ext={l.ext}
      >
        {l.name}
      </button>
    ))}
  </div>
  <label slot="input-tools" class="ml-2 flex items-center gap-1 text-xs text-slate-500">
    根类型名
    <input
      id="root-name"
      class="w-24 rounded-md border border-slate-200 bg-white px-1.5 py-0.5 font-mono text-xs dark:border-slate-700 dark:bg-slate-900"
      value="Root"
      spellcheck="false"
    />
  </label>

  <textarea
    slot="input"
    id="src"
    class="min-h-[14rem] w-full flex-1 resize-none bg-slate-50 p-3 font-mono text-xs leading-relaxed outline-none lg:min-h-0 dark:bg-slate-900/60"
    spellcheck="false"
    placeholder="在此粘贴 JSON…（失去焦点后自动生成代码）"
  ></textarea>

  <button slot="output-tools" id="copy" class="tool-btn tool-btn-sm" title="复制生成的代码">复制</button>
  <button slot="output-tools" id="dl" class="tool-btn tool-btn-sm" title="下载代码文件">下载</button>

  <pre
    slot="output"
    id="out"
    class="min-h-0 flex-1 overflow-auto bg-slate-50 p-3 font-mono text-xs leading-relaxed whitespace-pre text-slate-700 lg:min-h-0 dark:bg-slate-900/60 dark:text-slate-200"
  ><span class="text-slate-400">生成的代码将显示在这里…</span></pre>
</Tool>

<script>
  import { jsonToCode, type TargetLang } from '../../lib/code/json2code';

  const SAMPLE = JSON.stringify(
    {
      id: 1001,
      name: '张三',
      email: 'zhangsan@example.com',
      active: true,
      balance: 128.5,
      tags: ['vip', 'beta'],
      address: { province: '广东', city: '深圳', zip: '518000' },
      orders: [
        { orderNo: 'A2024001', amount: 99.5, paid: true },
        { orderNo: 'A2024002', amount: 12, paid: false },
      ],
      deletedAt: null,
    },
    null,
    2
  );

  const src = document.getElementById('src') as HTMLTextAreaElement;
  const out = document.getElementById('out') as HTMLPreElement;
  const rootName = document.getElementById('root-name') as HTMLInputElement;
  const tabs = document.querySelectorAll('#lang-tabs button');
  let lang: TargetLang = 'typescript';
  let ext = 'ts';

  function setActiveTab(btn: HTMLButtonElement) {
    tabs.forEach((b) => {
      const active = b === btn;
      b.className = `rounded-md px-2 py-0.5 text-xs transition ${
        active ? 'bg-brand-600 text-white' : 'text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800'
      }`;
    });
    lang = btn.dataset.lang as TargetLang;
    ext = btn.dataset.ext ?? 'txt';
  }

  tabs.forEach((b) => b.addEventListener('click', () => { setActiveTab(b as HTMLButtonElement); render(); }));

  function render() {
    const text = src.value.trim();
    if (!text) {
      out.textContent = '';
      out.innerHTML = '<span class="text-slate-400">生成的代码将显示在这里…</span>';
      return;
    }
    const { code, error } = jsonToCode(text, { lang, rootName: rootName.value });
    if (error) {
      out.textContent = error;
      out.className =
        'min-h-0 flex-1 overflow-auto bg-rose-50 p-3 font-mono text-xs leading-relaxed whitespace-pre text-rose-600 dark:bg-rose-950/30 dark:text-rose-400';
    } else {
      out.textContent = code;
      out.className =
        'min-h-0 flex-1 overflow-auto bg-slate-50 p-3 font-mono text-xs leading-relaxed whitespace-pre text-slate-700 dark:bg-slate-900/60 dark:text-slate-200';
    }
  }

  src.addEventListener('blur', render);
  rootName.addEventListener('input', render);

  document.getElementById('copy')!.addEventListener('click', async () => {
    await navigator.clipboard.writeText(out.textContent ?? '');
    const btn = document.getElementById('copy') as HTMLButtonElement;
    btn.textContent = '已复制';
    setTimeout(() => (btn.textContent = '复制'), 1200);
  });

  document.getElementById('dl')!.addEventListener('click', () => {
    const blob = new Blob([out.textContent ?? ''], { type: 'text/plain' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `model.${ext}`;
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // 预填示例，打开即有内容
  src.value = SAMPLE;
  render();
</script>
