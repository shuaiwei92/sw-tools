---
import Tool from '../../layouts/Tool.astro';
---

<Tool
  title="正则表达式测试 · sw-tools"
  description="实时匹配高亮、分组捕获与替换预览，附常用正则速查表。"
  toolName="正则表达式测试"
  categoryHref="/#text"
  categoryName="文本处理"
  inputLabel="正则与测试文本"
  outputLabel="匹配结果"
>
  <div slot="input" class="flex min-h-0 flex-1 flex-col">
    <div class="shrink-0 space-y-3 border-b border-slate-200 p-3 dark:border-slate-700">
      <div>
        <label class="calc-label" for="pattern">正则表达式</label>
        <div class="flex items-center gap-2">
          <span class="font-mono text-slate-400">/</span>
          <input id="pattern" class="calc-input font-mono text-xs" placeholder="如 \d{4}-\d{2}-\d{2}" value="\d{4}-\d{2}-\d{2}" />
          <span class="font-mono text-slate-400">/</span>
          <span id="flags" class="font-mono text-sm text-brand-600 dark:text-brand-300">g</span>
        </div>
      </div>
      <div class="flex flex-wrap gap-2.5">
        <label class="flex cursor-pointer items-center gap-1 text-xs text-slate-500"><input type="checkbox" class="accent-brand-600" data-flag="g" checked />g 全局</label>
        <label class="flex cursor-pointer items-center gap-1 text-xs text-slate-500"><input type="checkbox" class="accent-brand-600" data-flag="i" />i 忽略大小写</label>
        <label class="flex cursor-pointer items-center gap-1 text-xs text-slate-500"><input type="checkbox" class="accent-brand-600" data-flag="m" />m 多行</label>
        <label class="flex cursor-pointer items-center gap-1 text-xs text-slate-500"><input type="checkbox" class="accent-brand-600" data-flag="s" />s 点号匹配换行</label>
      </div>
    </div>
    <textarea
      id="subject"
      class="min-h-[12rem] w-full flex-1 resize-none bg-slate-50 p-3 font-mono text-xs leading-relaxed outline-none lg:min-h-0 dark:bg-slate-900/60"
      spellcheck="false"
    >订单日期 2026-10-14，发货日期 2026-11-01，截止 2027-01-31。</textarea>
  </div>

  <span slot="output-tools" id="match-count" class="text-xs text-slate-400"></span>
  <span slot="output-tools" id="regex-error" class="text-xs text-rose-600 dark:text-rose-400"></span>

  <div slot="output" class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-3">
    <div class="shrink-0">
      <span class="calc-label">匹配预览</span>
      <div id="preview" class="rounded-lg border border-slate-200 bg-white p-3 text-sm leading-relaxed whitespace-pre-wrap break-all dark:border-slate-700 dark:bg-slate-900"></div>
    </div>
    <div id="groups-wrap" class="hidden shrink-0">
      <span class="calc-label">匹配与分组</span>
      <div id="groups" class="flex flex-col gap-1.5 font-mono text-xs"></div>
    </div>
    <div class="grid shrink-0 gap-3 sm:grid-cols-[1fr_auto]">
      <div>
        <label class="calc-label" for="replacement">替换预览（支持 $1 / $&amp; 语法）</label>
        <input id="replacement" class="calc-input font-mono text-xs" placeholder="如 $1年$2月$3日" value="$1年$2月$3日" />
      </div>
      <div>
        <span class="calc-label">结果</span>
        <div id="replaced" class="calc-input overflow-x-auto font-mono text-xs leading-relaxed whitespace-pre-wrap break-all"></div>
      </div>
    </div>
    <!-- 速查表默认展开，撑满右栏剩余空间；行高自适应分摊 -->
    <details open class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700">
      <summary class="shrink-0 cursor-pointer px-3 py-2 text-sm font-semibold text-slate-600 dark:text-slate-300">常用正则速查（点击可收起）</summary>
      <div class="grid flex-1 auto-rows-fr content-start gap-1.5 overflow-y-auto p-3 pt-0 text-sm sm:grid-cols-2">
        <div class="res-row"><span class="k font-mono">^\d+$</span><span class="v font-mono">整数</span></div>
        <div class="res-row"><span class="k font-mono">^-?\d+(\.\d+)?$</span><span class="v font-mono">小数</span></div>
        <div class="res-row"><span class="k font-mono">^\d{17}[\dXx]$</span><span class="v font-mono">身份证号</span></div>
        <div class="res-row"><span class="k font-mono">1[3-9]\d{9}</span><span class="v font-mono">手机号</span></div>
        <div class="res-row"><span class="k font-mono">[\w.+-]+@[\w-]+\.[\w.]+</span><span class="v font-mono">邮箱</span></div>
        <div class="res-row"><span class="k font-mono">https?://\S+</span><span class="v font-mono">URL</span></div>
        <div class="res-row"><span class="k font-mono">\d{4}-\d{2}-\d{2}</span><span class="v font-mono">日期（ISO）</span></div>
        <div class="res-row"><span class="k font-mono">(\d{4})-(\d{2})-(\d{2})</span><span class="v font-mono">日期分组捕获</span></div>
        <div class="res-row"><span class="k font-mono">^(\d{3}|0\d{2})-?\d{8}$</span><span class="v font-mono">区号固话</span></div>
        <div class="res-row"><span class="k font-mono">^[\u4e00-\u9fa5]{2,4}$</span><span class="v font-mono">中文姓名</span></div>
        <div class="res-row"><span class="k font-mono">[\u4e00-\u9fa5]</span><span class="v font-mono">单个汉字</span></div>
        <div class="res-row"><span class="k font-mono">(?&lt;=V)\d+</span><span class="v font-mono">后行断言（版本号）</span></div>
        <div class="res-row"><span class="k font-mono">\b\w+\b</span><span class="v font-mono">单词（英文）</span></div>
        <div class="res-row"><span class="k font-mono">\s+</span><span class="v font-mono">连续空白</span></div>
      </div>
    </details>
  </div>
</Tool>

<script>
  const patternEl = document.getElementById('pattern') as HTMLInputElement;
  const subjectEl = document.getElementById('subject') as HTMLTextAreaElement;
  const flagsEl = document.getElementById('flags')!;
  const previewEl = document.getElementById('preview')!;
  const matchCount = document.getElementById('match-count')!;
  const errorEl = document.getElementById('regex-error')!;
  const groupsWrap = document.getElementById('groups-wrap')!;
  const groupsEl = document.getElementById('groups')!;
  const replacementEl = document.getElementById('replacement') as HTMLInputElement;
  const replacedEl = document.getElementById('replaced')!;

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  function currentFlags(): string {
    return Array.from(document.querySelectorAll<HTMLInputElement>('[data-flag]'))
      .filter((c) => c.checked)
      .map((c) => c.dataset.flag!)
      .join('');
  }

  function run() {
    const flags = currentFlags();
    flagsEl.textContent = flags || '（无）';
    errorEl.textContent = '';
    groupsWrap.classList.add('hidden');

    let re: RegExp;
    try {
      re = new RegExp(patternEl.value, flags.includes('g') ? flags : flags + 'g');
    } catch (e) {
      errorEl.textContent = `正则无效：${(e as Error).message}`;
      previewEl.textContent = subjectEl.value;
      matchCount.textContent = '';
      replacedEl.textContent = '';
      return;
    }

    const subject = subjectEl.value;
    // 收集匹配区间（跳过零宽匹配，避免死循环）
    const ranges: [number, number][] = [];
    const matches: RegExpExecArray[] = [];
    re.lastIndex = 0;
    let m: RegExpExecArray | null;
    while ((m = re.exec(subject)) !== null) {
      matches.push(m);
      ranges.push([m.index, m.index + m[0].length]);
      if (m[0].length === 0) re.lastIndex++;
    }

    // 高亮拼接
    let html = '';
    let pos = 0;
    for (const [s, e] of ranges) {
      html += escapeHtml(subject.slice(pos, s));
      html += `<mark class="rounded bg-amber-200 px-0.5 text-slate-900 dark:bg-amber-500/40 dark:text-amber-100">${escapeHtml(subject.slice(s, e))}</mark>`;
      pos = e;
    }
    html += escapeHtml(subject.slice(pos));
    previewEl.innerHTML = html || '<span class="text-slate-400">（无内容）</span>';

    matchCount.textContent = matches.length ? `共 ${matches.length} 处匹配` : '无匹配';

    if (matches.length) {
      groupsWrap.classList.remove('hidden');
      groupsEl.innerHTML = matches
        .map((mt, i) => {
          const parts = [`#${i + 1} 「${escapeHtml(mt[0])}」`];
          for (let g = 1; g < mt.length; g++) {
            parts.push(`<span class="text-slate-400">$${g}</span>=${mt[g] === undefined ? '<span class="text-slate-300">undefined</span>' : escapeHtml(mt[g])}`);
          }
          return `<div class="rounded-md bg-slate-50 px-2 py-1 dark:bg-slate-800/60">${parts.join('　')}</div>`;
        })
        .join('');
    }

    // 替换预览
    try {
      const reRep = new RegExp(patternEl.value, flags.includes('g') ? flags : flags + 'g');
      replacedEl.textContent = subject.replace(reRep, replacementEl.value);
    } catch {
      replacedEl.textContent = '';
    }
  }

  [patternEl, subjectEl, replacementEl].forEach((el) => el.addEventListener('input', run));
  document.querySelectorAll('[data-flag]').forEach((c) => c.addEventListener('change', run));
  run();
</script>
