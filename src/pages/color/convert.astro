---
import Tool from '../../layouts/Tool.astro';
import Icon from '../../components/Icon.astro';

/** 左栏快捷命名色（取自 lib 的 NAMED_COLORS 常用子集） */
const QUICK_COLORS = [
  '#ef4444', '#f97316', '#f59e0b', '#eab308', '#84cc16', '#22c55e',
  '#10b981', '#14b8a6', '#06b6d4', '#0ea5e9', '#3b82f6', '#6366f1',
  '#8b5cf6', '#a855f7', '#d946ef', '#ec4899', '#f43f5e', '#64748b',
];
---

<Tool
  title="颜色转换 / 配色 · sw-tools"
  toolName="颜色转换 / 配色"
  description="HEX / RGB / HSL / HSV 互转，WCAG 对比度检测，互补 / 邻近 / 三角等配色方案与明暗阶，点击任意色值即可复制或置为当前色。"
  categoryHref="/#color"
  categoryName="取色 / 配色"
  inputLabel="颜色输入"
  outputLabel="转换与配色"
  columns="left-narrow"
>
  <!-- 左：输入与快捷操作 -->
  <div slot="input" class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-3">
    <!-- 大色预览 -->
    <div
      id="preview"
      class="flex h-28 items-end justify-center rounded-xl border border-slate-200 pb-2 text-xs font-medium dark:border-slate-700"
      style="background:#6366f1;color:#ffffff"
    >
      <span id="preview-text">#6366f1</span>
    </div>

    <div class="flex gap-2">
      <input
        id="picker"
        type="color"
        value="#6366f1"
        class="h-9 w-12 shrink-0 cursor-pointer rounded-md border border-slate-200 bg-white p-0.5 dark:border-slate-700 dark:bg-slate-900"
        title="打开系统取色器"
      />
      <div class="min-w-0 flex-1">
        <label class="calc-label" for="in-color">颜色值</label>
        <input id="in-color" type="text" spellcheck="false" class="calc-input font-mono text-sm" value="#6366f1" placeholder="#6366f1 / rgb(99,102,241) / hsl(239,84%,67%) / red" />
      </div>
    </div>
    <p class="text-xs text-slate-400" id="color-hint">支持 HEX、RGB(A)、HSL(A)、现代空格语法与常用命名色</p>

    <!-- 快捷命名色 -->
    <div>
      <span class="calc-label">快捷色</span>
      <div class="flex flex-wrap gap-1.5">
        {QUICK_COLORS.map((c) => (
          <button class="h-6 w-6 rounded-md border border-slate-200 transition hover:scale-110 dark:border-slate-700" style={`background:${c}`} data-quick={c} title={c} />
        ))}
      </div>
    </div>

    <!-- 明度 / 饱和度微调 -->
    <div class="space-y-2">
      <div>
        <span class="calc-label">明度 <span class="font-mono text-slate-400" id="lv-val">0</span></span>
        <input id="sl-lightness" type="range" min="-50" max="50" value="0" class="w-full accent-brand-600" />
      </div>
      <div>
        <span class="calc-label">饱和度 <span class="font-mono text-slate-400" id="st-val">0</span></span>
        <input id="sl-saturation" type="range" min="-50" max="50" value="0" class="w-full accent-brand-600" />
      </div>
      <p class="text-xs text-slate-400">拖动滑块在当前色基础上调整；调整后色值输入框同步更新。</p>
    </div>
  </div>

  <!-- 右：转换结果 -->
  <div slot="output" class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-3">
    <!-- 格式互转 -->
    <div class="result-card" id="fmt-card">
      <span class="text-[0.8125rem] font-semibold text-slate-600 dark:text-slate-300">格式互转（点击复制）</span>
      <div class="mt-1" id="fmt-rows"></div>
    </div>

    <!-- WCAG 对比度 -->
    <div class="rounded-xl border border-slate-200 p-3 dark:border-slate-700">
      <span class="text-[0.8125rem] font-semibold text-slate-600 dark:text-slate-300">WCAG 对比度</span>
      <div class="mt-1 grid grid-cols-2 gap-2" id="contrast-grid"></div>
      <p class="mt-1.5 text-xs text-slate-400" id="best-text"></p>
    </div>

    <!-- 配色方案 -->
    <div class="rounded-xl border border-slate-200 p-3 dark:border-slate-700">
      <span class="text-[0.8125rem] font-semibold text-slate-600 dark:text-slate-300">配色方案（点击色块置为当前色）</span>
      <div class="mt-2 space-y-2" id="harmony-list"></div>
    </div>

    <!-- 明暗阶 / 饱和阶 -->
    <div class="rounded-xl border border-slate-200 p-3 dark:border-slate-700">
      <span class="text-[0.8125rem] font-semibold text-slate-600 dark:text-slate-300">明暗阶 / 饱和阶（点击应用）</span>
      <div class="mt-2 space-y-2">
        <div>
          <span class="text-xs text-slate-400">明度 −40% → +40%</span>
          <div class="mt-1 flex overflow-hidden rounded-lg" id="shade-row"></div>
        </div>
        <div>
          <span class="text-xs text-slate-400">饱和度 −40% → +40%</span>
          <div class="mt-1 flex overflow-hidden rounded-lg" id="sat-row"></div>
        </div>
      </div>
    </div>
  </div>
</Tool>

<script>
  import {
    parseColor,
    formatHex,
    formatRgb,
    formatHsl,
    rgbToHsl,
    rgbToHsv,
    contrastRatio,
    wcagLevel,
    bestTextOn,
    harmonies,
    adjustLightness,
    adjustSaturation,
    type RGBA,
  } from '../../lib/color/convert';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const preview = $('preview');
  const previewText = $('preview-text');
  const picker = $<HTMLInputElement>('picker');
  const inColor = $<HTMLInputElement>('in-color');
  const hint = $('color-hint');
  const fmtRows = $('fmt-rows');
  const contrastGrid = $('contrast-grid');
  const bestText = $('best-text');
  const harmonyList = $('harmony-list');
  const shadeRow = $('shade-row');
  const satRow = $('sat-row');
  const slLightness = $<HTMLInputElement>('sl-lightness');
  const slSaturation = $<HTMLInputElement>('sl-saturation');
  const lvVal = $('lv-val');
  const stVal = $('st-val');

  const HARMONY_LABELS: Record<string, string> = {
    complementary: '互补色（+180°）',
    analogous: '邻近色（±30°）',
    triadic: '三角色（+120°）',
    splitComplementary: '分裂互补（+150° / +210°）',
    tetradic: '四角色（+90° 系列）',
    monochromatic: '单色阶（明度变化）',
  };
  const HARMONY_ORDER = ['complementary', 'analogous', 'triadic', 'splitComplementary', 'tetradic', 'monochromatic'] as const;

  /** 当前颜色（基准色，滑块调整基于它） */
  let current: RGBA = { r: 99, g: 102, b: 241, a: 1 };
  /** 基准色（未施加滑块调整的原始色） */
  let base: RGBA = current;

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  const swatch = (c: RGBA, extra = '') =>
    `<button class="h-7 min-w-9 flex-1 rounded-md border border-black/10 transition hover:scale-105 dark:border-white/15" style="background:${formatHex(c, true)}" data-set="${formatHex(c, true)}" title="${formatHex(c, true)}${extra}"></button>`;

  function applyColor(c: RGBA) {
    current = c;
    const hex = formatHex(c, false);
    const hexFull = formatHex(c, true);
    preview.style.background = hexFull;
    preview.style.color = bestTextOn(c);
    previewText.textContent = hexFull;
    if (document.activeElement !== inColor) inColor.value = hexFull;
    picker.value = hex;
    renderConversions();
  }

  function renderConversions() {
    const c = current;
    const hsl = rgbToHsl(c);
    const hsv = rgbToHsv(c);
    const rows: [string, string][] = [
      ['HEX', formatHex(c, true)],
      ['RGB', formatRgb(c)],
      ['HSL', formatHsl(c)],
      ['HSV', `hsv(${hsv.h}, ${hsv.s}%, ${hsv.v}%)`],
      ['Hue 色相', `${hsl.h}°`],
      ['亮度 L', `${hsl.l}%`],
    ];
    fmtRows.innerHTML = rows
      .map(
        ([k, v]) =>
          `<div class="kv"><span class="k">${k}</span><span class="font-mono text-sm" data-copy="${esc(v)}" title="点击复制">${esc(v)}</span></div>`
      )
      .join('');

    // WCAG 对比度：白底 / 黑底
    const onWhite = contrastRatio(c, { r: 255, g: 255, b: 255, a: 1 });
    const onBlack = contrastRatio(c, { r: 0, g: 0, b: 0, a: 1 });
    const cell = (label: string, ratio: number) =>
      `<div class="rounded-lg border border-slate-100 p-2 text-center dark:border-slate-800">
        <div class="text-xs text-slate-400">${label}</div>
        <div class="mt-0.5 text-lg font-bold tabular-nums">${ratio.toFixed(2)}</div>
        <div class="text-xs font-semibold ${ratio >= 4.5 ? 'text-emerald-600 dark:text-emerald-400' : ratio >= 3 ? 'text-amber-600 dark:text-amber-400' : 'text-rose-600 dark:text-rose-400'}">${wcagLevel(ratio)}</div>
      </div>`;
    contrastGrid.innerHTML = cell('白色背景', onWhite) + cell('黑色背景', onBlack);
    const best = bestTextOn(c);
    bestText.textContent = `作为背景色时推荐文字色：${best}（对比度 ${Math.max(onWhite, onBlack).toFixed(2)}）`;

    // 配色方案
    const h = harmonies(c);
    harmonyList.innerHTML = HARMONY_ORDER.map(
      (name) =>
        `<div>
          <div class="text-xs text-slate-400">${HARMONY_LABELS[name]}</div>
          <div class="mt-1 flex gap-1.5">${h[name].map((x) => swatch(x, ' · 点击置为当前色')).join('')}</div>
        </div>`
    ).join('');

    // 明暗阶 / 饱和阶
    shadeRow.innerHTML = Array.from({ length: 9 }, (_, i) => swatch(adjustLightness(c, -40 + i * 10))).join('');
    satRow.innerHTML = Array.from({ length: 9 }, (_, i) => swatch(adjustSaturation(c, -40 + i * 10))).join('');
  }

  // ---- 事件 ----
  inColor.addEventListener('input', () => {
    const c = parseColor(inColor.value);
    if (c) {
      hint.textContent = '支持 HEX、RGB(A)、HSL(A)、现代空格语法与常用命名色';
      hint.className = 'text-xs text-slate-400';
      base = c;
      slLightness.value = '0';
      slSaturation.value = '0';
      lvVal.textContent = '0';
      stVal.textContent = '0';
      applyColor(c);
    } else {
      hint.textContent = '✗ 无法解析该颜色值';
      hint.className = 'text-xs text-rose-600 dark:text-rose-400';
    }
  });

  picker.addEventListener('input', () => {
    const c = parseColor(picker.value);
    if (c) {
      base = c;
      slLightness.value = '0';
      slSaturation.value = '0';
      lvVal.textContent = '0';
      stVal.textContent = '0';
      applyColor(c);
    }
  });

  const onSlide = () => {
    const lv = Number(slLightness.value);
    const st = Number(slSaturation.value);
    lvVal.textContent = String(lv);
    stVal.textContent = String(st);
    applyColor(adjustSaturation(adjustLightness(base, lv), st));
  };
  slLightness.addEventListener('input', onSlide);
  slSaturation.addEventListener('input', onSlide);

  document.querySelectorAll<HTMLButtonElement>('[data-quick]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const c = parseColor(btn.dataset.quick!);
      if (c) {
        base = c;
        slLightness.value = '0';
        slSaturation.value = '0';
        lvVal.textContent = '0';
        stVal.textContent = '0';
        applyColor(c);
      }
    });
  });

  // 点击色值复制 / 点击色块应用（事件代理）
  fmtRows.addEventListener('click', async (e) => {
    const el = (e.target as HTMLElement).closest('[data-copy]') as HTMLElement | null;
    if (!el) return;
    try {
      await navigator.clipboard.writeText(el.dataset.copy!);
      const old = el.textContent;
      el.textContent = '已复制 ✓';
      window.setTimeout(() => (el.textContent = old), 900);
    } catch {
      /* 忽略 */
    }
  });
  for (const box of [harmonyList, shadeRow, satRow]) {
    box.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest('[data-set]') as HTMLElement | null;
      if (!el) return;
      const c = parseColor(el.dataset.set!);
      if (c) {
        base = c;
        slLightness.value = '0';
        slSaturation.value = '0';
        lvVal.textContent = '0';
        stVal.textContent = '0';
        applyColor(c);
      }
    });
  }

  renderConversions();
</script>
