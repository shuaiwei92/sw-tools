---
import Converter from '../../layouts/Converter.astro';
---

<Converter
  title="Base 系列编码 · sw-tools"
  description="Base16 / Base32 / Base58 / Base64 / Base64URL / Base85 互转，UTF-8 安全，纯浏览器本地处理。"
  toolName="Base 系列编码"
  inputPlaceholder="在此粘贴文本或编码串…（自动识别方向，失去焦点后转换）"
  outputLabel="输出"
  downloadName="base-result"
  downloadExt="txt"
  categoryHref="/#codec"
  categoryName="编码 / 加密"
>
  <label slot="input-tools" class="ml-1 flex items-center gap-1 text-xs text-slate-500">
    算法
    <select
      id="algo"
      class="rounded-md border border-slate-200 bg-white px-1.5 py-0.5 text-xs dark:border-slate-700 dark:bg-slate-900"
    >
      <option value="base16">Base16（Hex）</option>
      <option value="base32">Base32（RFC 4648）</option>
      <option value="base58">Base58（比特币字母表）</option>
      <option value="base64" selected>Base64</option>
      <option value="base64url">Base64URL</option>
      <option value="base85">Base85（Ascii85）</option>
    </select>
  </label>
  <label slot="input-tools" class="ml-2 flex items-center gap-1 text-xs text-slate-500">
    方向
    <select
      id="direction"
      class="rounded-md border border-slate-200 bg-white px-1.5 py-0.5 text-xs dark:border-slate-700 dark:bg-slate-900"
    >
      <option value="auto">自动</option>
      <option value="encode">文本 → 编码</option>
      <option value="decode">编码 → 文本</option>
    </select>
  </label>
</Converter>

<script>
  import {
    baseEncodeText,
    baseDecodeText,
    looksLikeAlgo,
    type BaseAlgo,
  } from '../../lib/codec/baseSeries';
  import { setupConverter } from '../../lib/convert/converter-ui';

  const SAMPLE = 'Hello, sw-tools! 你好，世界';

  const algoEl = () => document.getElementById('algo') as HTMLSelectElement;
  const dirEl = () => document.getElementById('direction') as HTMLSelectElement;

  setupConverter({
    downloadName: 'base-result',
    downloadExt: 'txt',
    convert: (input) => {
      const algo = algoEl().value as BaseAlgo;
      const dir =
        dirEl().value === 'auto' ? (looksLikeAlgo(input, algo) ? 'decode' : 'encode') : dirEl().value;
      return dir === 'decode' ? baseDecodeText(input, algo) : baseEncodeText(input, algo);
    },
    getDirection: () => dirEl().value,
    detectDirection: (input) => (looksLikeAlgo(input, algoEl().value as BaseAlgo) ? 'decode' : 'encode'),
    directionLabels: { encode: '文本 → 编码', decode: '编码 → 文本' },
    sample: SAMPLE,
  });

  // 算法切换后立即重算
  algoEl().addEventListener('change', () => {
    document.getElementById('input')?.dispatchEvent(new Event('blur'));
  });
</script>
