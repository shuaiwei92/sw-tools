---
import Converter from '../../layouts/Converter.astro';
---

<Converter
  title="Unicode 转义 · sw-tools"
  description="文本与 \\uXXXX 转义序列互转，支持 emoji 等星区字符的代理对处理，纯浏览器本地处理。"
  toolName="Unicode 转义"
  inputPlaceholder="在此粘贴文本或 \\uXXXX 序列…（自动识别方向，失去焦点后转换）"
  outputLabel="输出"
  downloadName="unicode-result"
  downloadExt="txt"
  categoryHref="/#codec"
  categoryName="编码 / 加密"
>
  <label slot="input-tools" class="ml-1 flex items-center gap-1 text-xs text-slate-500">
    方向
    <select
      id="direction"
      class="rounded-md border border-slate-200 bg-white px-1.5 py-0.5 text-xs dark:border-slate-700 dark:bg-slate-900"
    >
      <option value="auto">自动</option>
      <option value="escape">文本 → \\uXXXX</option>
      <option value="unescape">\\uXXXX → 文本</option>
    </select>
  </label>
  <label
    slot="input-tools"
    class="ml-2 flex items-center gap-1 text-xs text-slate-500"
    title="默认仅转义非 ASCII 字符；勾选后 ASCII 字符也会转义为 \\uXXXX"
  >
    <input type="checkbox" id="all-chars" class="h-3.5 w-3.5 accent-brand-600" />
    包含 ASCII
  </label>
</Converter>

<script>
  import { unicodeEscape, unicodeUnescape, looksEscaped } from '../../lib/codec/unicode';
  import { setupConverter } from '../../lib/convert/converter-ui';

  const SAMPLE = 'Hello 世界 🌏 sw-tools';

  const dirEl = () => document.getElementById('direction') as HTMLSelectElement;
  const allEl = () => document.getElementById('all-chars') as HTMLInputElement;

  setupConverter({
    downloadName: 'unicode-result',
    downloadExt: 'txt',
    convert: (input) => {
      const dir =
        dirEl().value === 'auto' ? (looksEscaped(input) ? 'unescape' : 'escape') : dirEl().value;
      return dir === 'unescape'
        ? unicodeUnescape(input)
        : unicodeEscape(input, !allEl().checked);
    },
    getDirection: () => dirEl().value,
    detectDirection: (input) => (looksEscaped(input) ? 'unescape' : 'escape'),
    directionLabels: { escape: '文本 → \\uXXXX', unescape: '\\uXXXX → 文本' },
    sample: SAMPLE,
  });

  allEl().addEventListener('change', () => {
    document.getElementById('input')?.dispatchEvent(new Event('blur'));
  });
</script>
